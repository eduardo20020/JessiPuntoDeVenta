@model VentaIndexViewModel
@{
    ViewData["Title"] = "Venta";
}

<h1 class="h3 mb-3">Nueva venta</h1>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    var cls = Model.MensajeEsError ? "danger" : "success";
    <div class="alert alert-@cls">@Model.Mensaje</div>
}

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header">Agregar al ticket</div>
            <div class="card-body">
                <form asp-action="AgregarLinea" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">Producto</label>
                        <select name="idProducto" class="form-select" asp-items="Model.Productos" required>
                            <option value="">— Seleccionar —</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Cantidad</label>
                        <input name="cantidad" type="number" min="1" class="form-control" value="@Model.Cantidad" />
                    </div>
                    <button type="submit" class="btn btn-outline-primary">Agregar</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Ticket</span>
                @if (Model.Lineas.Count > 0)
                {
                    <form asp-action="Vaciar" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">Vaciar</button>
                    </form>
                }
            </div>
            <div class="card-body p-0">
                @if (Model.Lineas.Count == 0)
                {
                    <p class="p-3 text-muted mb-0">Aún no hay productos en el ticket.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table mb-0 align-middle">
                            <thead>
                                <tr>
                                    <th>Producto</th>
                                    <th class="text-end">P. unit.</th>
                                    <th class="text-end">Cant.</th>
                                    <th class="text-end">Subtotal</th>
                                    <th class="text-end">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                            @for (var i = 0; i < Model.Lineas.Count; i++)
                            {
                                var l = Model.Lineas[i];
                                <tr>
                                    <td>@l.Nombre</td>
                                    <td class="text-end">@l.PrecioUnitario.ToString("N2")</td>
                                    <td class="text-end">@l.Cantidad</td>
                                    <td class="text-end">@l.Subtotal.ToString("N2")</td>
                                    <td class="text-end">
                                        <form asp-action="AgregarLinea" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="idProducto" value="@l.IdProducto" />
                                            <input type="hidden" name="cantidad" value="1" />
                                            <button type="submit" class="btn btn-sm btn-outline-success" title="Agregar uno" aria-label="Agregar uno de @l.Nombre">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                                    <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z" />
                                                </svg>
                                            </button>
                                        </form>
                                        <form asp-action="QuitarLinea" method="post" class="d-inline ms-1">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="index" value="@i" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar producto" aria-label="Eliminar @l.Nombre">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                                    <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z" />
                                                    <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1 0-2H5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1h2.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3h11V2h-11v1z" />
                                                </svg>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th colspan="3" class="text-end">Total</th>
                                    <th class="text-end">@Model.Total.ToString("N2")</th>
                                    <th></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <div class="p-3 border-top">
                        <form asp-action="Confirmar" method="post" class="row g-2 align-items-end">
                            @Html.AntiForgeryToken()
                            <div class="col-md-4">
                                <label class="form-label">Forma de pago</label>
                                <input name="formaPago" class="form-control" placeholder="efectivo, tarjeta…" value="@Model.FormaPago" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Recibido</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input id="montoRecibido" type="text" inputmode="decimal" class="form-control text-end" placeholder="0.00" autocomplete="off" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Cambio</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input id="montoCambio" type="text" class="form-control text-end" value="0.00" readonly />
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="card bg-light border-0 mt-2">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <strong>Calculadora de pago</strong>
                                            <span class="text-muted">Total: $@Model.Total.ToString("N2")</span>
                                        </div>
                                        <div class="row g-2" id="tecladoPago">
                                            @foreach (var tecla in new[] { "7", "8", "9", "4", "5", "6", "1", "2", "3", "0", ".", "←" })
                                            {
                                                <div class="col-4">
                                                    <button type="button" class="btn btn-outline-secondary w-100 btn-lg" data-tecla="@tecla">@tecla</button>
                                                </div>
                                            }
                                            <div class="col-6">
                                                <button type="button" class="btn btn-outline-danger w-100" id="limpiarPago">Limpiar</button>
                                            </div>
                                            <div class="col-6">
                                                <button type="button" class="btn btn-outline-primary w-100" id="pagoExacto">Pago exacto</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-success btn-lg w-100">Cobrar</button>
                            </div>
                        </form>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const total = Number('@Model.Total.ToString(System.Globalization.CultureInfo.InvariantCulture)');
            const recibido = document.getElementById('montoRecibido');
            const cambio = document.getElementById('montoCambio');
            const teclado = document.getElementById('tecladoPago');
            const limpiar = document.getElementById('limpiarPago');
            const exacto = document.getElementById('pagoExacto');

            if (!recibido || !cambio || !teclado || !limpiar || !exacto) {
                return;
            }

            const formatMoney = value => value.toLocaleString('es-MX', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });

            const normalizarMonto = value => {
                const limpio = value.replace(/,/g, '.').replace(/[^0-9.]/g, '');
                const partes = limpio.split('.');
                return partes.length <= 1 ? limpio : `${partes[0]}.${partes.slice(1).join('')}`;
            };

            const actualizarCambio = () => {
                recibido.value = normalizarMonto(recibido.value);
                const monto = Number(recibido.value || 0);
                cambio.value = formatMoney(Math.max(monto - total, 0));
            };

            teclado.addEventListener('click', event => {
                const boton = event.target.closest('[data-tecla]');
                if (!boton) {
                    return;
                }

                const tecla = boton.dataset.tecla;
                if (tecla === '←') {
                    recibido.value = recibido.value.slice(0, -1);
                } else if (tecla === '.' && recibido.value.includes('.')) {
                    return;
                } else {
                    recibido.value += tecla;
                }

                actualizarCambio();
            });

            limpiar.addEventListener('click', () => {
                recibido.value = '';
                actualizarCambio();
            });

            exacto.addEventListener('click', () => {
                recibido.value = total.toFixed(2);
                actualizarCambio();
            });

            recibido.addEventListener('input', actualizarCambio);
            actualizarCambio();
        })();
    </script>
}
