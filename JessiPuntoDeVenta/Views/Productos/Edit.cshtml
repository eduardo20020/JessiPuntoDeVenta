@model ProductoEditViewModel
@{
    ViewData["Title"] = "Editar producto";
    var proveedores = ViewBag.Proveedores as SelectList;
}

<h1 class="h3 mb-3">Editar producto</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="col-lg-7">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="IdProveedor" class="form-label">Proveedor</label>
        <select asp-for="IdProveedor" asp-items="proveedores" class="form-select">
            <option value="">(ninguno)</option>
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="CodigoBarras" class="form-label">Código de barras</label>
        <input asp-for="CodigoBarras" class="form-control" />
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="PrecioVenta" class="form-label">Precio venta</label>
            <input asp-for="PrecioVenta" class="form-control" />
            <span asp-validation-for="PrecioVenta" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="PrecioCosto" class="form-label">Precio costo</label>
            <input asp-for="PrecioCosto" class="form-control" />
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="Existencias" class="form-label"></label>
        <input asp-for="Existencias" class="form-control" />
        <span asp-validation-for="Existencias" class="text-danger"></span>
    </div>
    <div class="form-check mb-3">
        <input asp-for="Activo" class="form-check-input" />
        <label asp-for="Activo" class="form-check-label"></label>
    </div>
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a class="btn btn-link" asp-action="Index">Volver</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
