@model ReportesIndexViewModel
@{
    ViewData["Title"] = "Reportes";
}

<h1 class="h3 mb-3">Reportes de venta y margen</h1>

<form method="get" class="row g-2 align-items-end mb-4">
    <div class="col-auto">
        <label asp-for="Desde" class="form-label"></label>
        <input asp-for="Desde" class="form-control" type="date" />
    </div>
    <div class="col-auto">
        <label asp-for="Hasta" class="form-label"></label>
        <input asp-for="Hasta" class="form-control" type="date" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Actualizar</button>
    </div>
</form>

<div class="card mb-4">
    <div class="card-header">Totales en el rango</div>
    <div class="card-body row">
        <div class="col-md-4">
            <div class="text-muted small">Ventas</div>
            <div class="fs-4">@Model.Totales.VentasTotales.ToString("N2")</div>
        </div>
        <div class="col-md-4">
            <div class="text-muted small">Costo de ventas</div>
            <div class="fs-4">@Model.Totales.CostoTotal.ToString("N2")</div>
        </div>
        <div class="col-md-4">
            <div class="text-muted small">Margen bruto</div>
            <div class="fs-4">@Model.Totales.MargenBruto.ToString("N2")</div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">Por día</div>
    <div class="card-body p-0">
        @if (Model.PorDia.Count == 0)
        {
            <p class="p-3 text-muted mb-0">No hay ventas en el rango seleccionado.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Día</th>
                            <th class="text-end">Ventas</th>
                            <th class="text-end">Costo</th>
                            <th class="text-end">Margen</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var r in Model.PorDia)
                    {
                        <tr>
                            <td>@r.Dia.ToString("yyyy-MM-dd")</td>
                            <td class="text-end">@r.VentasTotales.ToString("N2")</td>
                            <td class="text-end">@r.CostoTotal.ToString("N2")</td>
                            <td class="text-end">@r.MargenBruto.ToString("N2")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
