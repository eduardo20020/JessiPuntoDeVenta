@model DatabaseProbeResult
@{
    ViewData["Title"] = "Inicio";
}

<div class="mb-4">
    <h1 class="display-6">Punto de venta</h1>
    <p class="text-muted mb-0">Estado de la base de datos MySQL (Dapper + MySqlConnector).</p>
</div>

<div class="card mb-3">
    <div class="card-body">
        @if (Model.Ok)
        {
            <div class="alert alert-success mb-0">
                <strong>Conexión OK.</strong> @Model.Message
                @if (Model.ProductoCount is not null)
                {
                    <span class="d-block mt-1">Productos en catálogo: <strong>@Model.ProductoCount</strong></span>
                }
            </div>
        }
        else
        {
            <div class="alert alert-danger mb-0">
                <strong>No se pudo conectar.</strong> @Model.Message
                <p class="small mt-2 mb-0">Revisa la cadena <code>ConnectionStrings:Default</code> en appsettings y que el esquema <code>pos_tiendita</code> exista.</p>
            </div>
        }
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5">Catálogo</h2>
                <p class="small text-muted">Proveedores y productos con costo, precio y existencias.</p>
                <a class="btn btn-outline-primary me-2" asp-controller="Proveedores" asp-action="Index">Proveedores</a>
                <a class="btn btn-primary" asp-controller="Productos" asp-action="Index">Productos</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5">Operación</h2>
                <p class="small text-muted">Cobrar y ver margen por periodo.</p>
                <a class="btn btn-success me-2" asp-controller="Ventas" asp-action="Index">Nueva venta</a>
                <a class="btn btn-outline-secondary" asp-controller="Reportes" asp-action="Index">Reportes</a>
            </div>
        </div>
    </div>
</div>
